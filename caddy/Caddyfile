# PRE-PRODUCTION
kiel-sealevel.westeurope.cloudapp.azure.com {

    redir /cms /cms/admin 308

    @strapiAdmin path /admin /admin/*
    handle @strapiAdmin {
        reverse_proxy cms-preprod:1337
    }

    handle_path /cms/* {
        reverse_proxy cms-preprod:1337
    }

    handle {
        reverse_proxy frontend-preprod:8080
    }
}

# STAGING
kiel-sealevel.westeurope.cloudapp.azure.com:8443 {

    redir /cms /cms/admin 308

    @strapiAdmin path /admin /admin/*
    handle @strapiAdmin {
        reverse_proxy cms-staging:1337
    }

    handle_path /cms/* {
        reverse_proxy cms-staging:1337
    }

    handle {
        reverse_proxy frontend-staging:8080
    }
}

