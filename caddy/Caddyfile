### PRE-PRODUCTION - HTTPS 443

kiel-sealevel.westeurope.cloudapp.azure.com {

    # Strapi API endpoint
    handle /api /api/* {
        reverse_proxy cms-preprod:1337
    }

    # Strapi uploads endpoint
    handle /uploads /uploads/* {
        reverse_proxy cms-preprod:1337
    }

    # Strapi administration endpoint
    handle /admin /admin/* {
        reverse_proxy cms-preprod:1337
    }

    # Frontend - default route
    handle {
        reverse_proxy frontend-preprod:8080
    }
}

### STAGING - HTTPS 8443

kiel-sealevel.westeurope.cloudapp.azure.com:8443 {

    # Strapi API endpoint
    handle /api /api/* {
        reverse_proxy cms-staging:1337
    }

    # Strapi uploads endpoint
    handle /uploads /uploads/* {
        reverse_proxy cms-staging:1337
    }

    # Strapi administration endpoint
    handle /admin /admin/* {
        reverse_proxy cms-staging:1337
    }

    # Frontend - default route
    handle {
        reverse_proxy frontend-staging:8080
    }
}

